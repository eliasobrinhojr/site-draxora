# Draxora — configuração do servidor (Hostinger)

# ===== Endereço único e seguro =====
# Sempre https://draxora.com.br (sem www). A CDN da Hostinger informa o protocolo em
# X-Forwarded-Proto; a regra só age quando ele diz "http", então não há risco de loop.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.draxora\.com\.br$ [NC]
  RewriteRule ^ https://draxora.com.br%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
  RewriteRule ^ https://draxora.com.br%{REQUEST_URI} [R=301,L]
</IfModule>

# ===== Segurança =====
# Sem listagem de pastas (ex.: /assets/amostra/ não mostra os arquivos)
Options -Indexes

# O deploy pelo Git copia o repositório inteiro para a public_html.
# Bloqueia o que não é página do site: pasta .git, arquivos ocultos, documentação e arquivos de apoio.
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)/\.(git|github|vscode|idea|claude)(/|$)
</IfModule>
<FilesMatch "(?i)(^\.|\.(md|txt|sql|log|bak|old|orig|swp|sh|ini|yml|yaml|lock|dist)$)">
  Require all denied
</FilesMatch>
<Files "robots.txt">
  Require all granted
</Files>
<Files "security.txt">
  Require all granted
</Files>

# Página própria para endereço inexistente (também usada pelos bloqueios acima)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Navegador sempre em HTTPS por 1 ano
  Header always set Strict-Transport-Security "max-age=31536000"
  # Não adivinhar tipo de arquivo; não deixar outros sites colocarem o nosso dentro de um iframe
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Outros sites recebem só o domínio de origem, nunca o caminho com utm_*
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # O site não usa câmera, microfone, localização nem pagamento no navegador
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Regras de conteúdo que não afetam Pixel, Google Ads, fontes nem Hotmart
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
  # Isola o site de janelas abertas por outros domínios (o WhatsApp continua abrindo normalmente)
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # Política completa em MODO RELATÓRIO: nada é bloqueado; o navegador só avisa /api/csp.php do que
  # sairia da lista. Depois de alguns dias sem avisos indevidos, ela passa a valer de verdade.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://connect.facebook.net https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://www.google.com https://www.googletagmanager.com https://*.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://*.doubleclick.net; img-src 'self' data: https://www.facebook.com https://www.google.com https://www.google.com.br https://googleads.g.doubleclick.net https://www.googletagmanager.com https://*.doubleclick.net; frame-src https://td.doubleclick.net https://www.googletagmanager.com; font-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; report-uri /api/csp.php"
  # Não anunciar versão do servidor/PHP
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# ===== Cache =====
# HTML sempre revalida (atualizações aparecem na hora);
# CSS/JS/imagens ficam em cache, e o ?v= no HTML força a versão nova a cada deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Fontes quase nunca mudam: 1 ano
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Links curtos para bio e canais (o Instagram estraga o "#" no link da bio)
<IfModule mod_rewrite.c>
  RewriteRule ^ig/?$ https://draxora.com.br/mapa-dos-sintomas/?utm_source=instagram&utm_medium=bio#amostra [R=302,NE,L]
  RewriteRule ^wpp/?$ https://draxora.com.br/mapa-dos-sintomas/?utm_source=whatsapp&utm_medium=canal#amostra [R=302,NE,L]
  RewriteRule ^canal/?$ https://whatsapp.com/channel/0029Vb9c3uxEwEjqXdFM4d09 [R=302,L]
  RewriteRule ^guia/?$ https://draxora.com.br/mapa-dos-sintomas/?utm_source=link#amostra [R=302,NE,L]
  # Download contado dos PDFs (links dos e-mails do Brevo): /baixar/guia e /baixar/folhas
  RewriteRule ^baixar/(guia|folhas)/?$ api/baixar.php?f=$1 [QSA,L]
</IfModule>

# 25/10/2026: o guia completo passou a ser gratuito (por e-mail). As amostras antigas (v3 e v5)
# levavam ao checkout da Hotmart, que foi desativado: agora levam ao cadastro do guia gratuito.
<IfModule mod_rewrite.c>
  RewriteRule ^assets/amostra/ https://draxora.com.br/mapa-dos-sintomas/?utm_source=amostra&utm_medium=pdf#amostra [R=301,NE,L]
</IfModule>

# PDFs do guia: fora da busca do Google (a entrega é pelo e-mail)
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
